<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>DBDReshade</AssemblyName>
    <RootNamespace>DBDReshade</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>2.0.0</Version>
    <Product>DBD Reshade</Product>
    <Authors>Joolace</Authors>
    <Copyright>Joolace</Copyright>
    <Description>ReShade installer and preset manager for Dead by Daylight</Description>

    <!-- Lets the project restore/build on non-Windows CI agents too -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Release publish: one self-contained exe, no .NET runtime needed on the user's PC -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <!-- WPF projects drop these two from the implicit usings; the code relies on them everywhere -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Fonts\Montserrat-Regular.ttf" />
    <Resource Include="Assets\Icons\*.png" />
    <!-- Presets + presets.json shipped inside the exe, unpacked on first run -->
    <EmbeddedResource Include="Seed\seed.zip" LogicalName="seed.zip" />
    <!-- Built-in translations; translations/*.json on GitHub override them at runtime -->
    <EmbeddedResource Include="Strings\*.json" LogicalName="strings.%(Filename).json" />
  </ItemGroup>

</Project>
