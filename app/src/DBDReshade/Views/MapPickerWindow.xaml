<Window x:Class="DBDReshade.Views.MapPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DBDReshade.ViewModels"
        xmlns:s="clr-namespace:DBDReshade.Services"
        xmlns:h="clr-namespace:DBDReshade.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MapPickerViewModel}"
        Title="{DynamicResource Map.Title}"
        Width="560" Height="640" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Map.Title}" />
            <TextBlock Margin="0,6,0,0">
                <Run Text="{DynamicResource Map.Preset}" Foreground="{DynamicResource TextMutedBrush}" />
                <Run Text="{Binding PresetName, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{DynamicResource Map.Subtitle}" />
        </StackPanel>

        <!-- Maps -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ListBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}"
                         IsEnabled="{Binding IsBusy, Converter={x:Static h:InverseBool.Instance}}"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type s:MapInfo}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceBrush}" CornerRadius="4"
                                        Padding="6,1" VerticalAlignment="Center"
                                        Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="10" Margin="0,0,4,0"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                        <TextBlock Text="{DynamicResource Map.Downloaded}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE707;" FontSize="14" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{DynamicResource Map.Loading}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{DynamicResource Map.NoMaps}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- Keys help -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,12,0,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="13" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{DynamicResource Map.Keys}" />
        </StackPanel>

        <!-- Progress + buttons -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Map.Close}" Margin="0,0,10,0" IsCancel="True"
                    Style="{StaticResource GhostButton}" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" IsDefault="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource Map.Start}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
