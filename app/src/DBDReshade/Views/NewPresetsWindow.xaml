<Window x:Class="DBDReshade.Views.NewPresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DBDReshade.ViewModels"
        xmlns:h="clr-namespace:DBDReshade.Helpers"
        xmlns:local="clr-namespace:DBDReshade.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:NewPresetsViewModel}"
        Title="{DynamicResource NewPresets.WindowTitle}"
        Style="{StaticResource ChromeWindow}"
        Width="640" Height="640" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
        <h:NullToVisibilityConverter x:Key="NullToVis" />
        <h:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />

        <!-- A whole card is one button: click it to open that preset -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <DockPanel>
    <local:TitleBar DockPanel.Dock="Top" />
    <DockPanel Margin="24">

        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0"
                    Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="20" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{DynamicResource NewPresets.Subtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- Buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="8,0,0,0"
                    Content="{DynamicResource NewPresets.ShowAll}" Command="{Binding ShowAllCommand}" IsDefault="True" />
            <Button DockPanel.Dock="Right" Content="{DynamicResource Common.Close}" Command="{Binding CloseCommand}" IsCancel="True" />
            <CheckBox IsChecked="{Binding ShowOnStartup}" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource NewPresets.ShowOnStartup}" TextWrapping="Wrap" FontSize="12" />
            </CheckBox>
        </DockPanel>

        <!-- New presets -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NewPresetItem}">
                        <Button Style="{StaticResource CardButton}" Margin="0,0,0,10" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" ToolTip="{DynamicResource NewPresets.OpenTip}">
                            <DockPanel>
                                <!-- Thumbnail -->
                                <Border DockPanel.Dock="Left" Width="160" Height="90" CornerRadius="6" ClipToBounds="True" Margin="0,0,14,0"
                                        Background="{DynamicResource BackgroundBrush}">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="22" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}" />
                                    </Grid>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,4,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Preset.DisplayName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"
                                               Visibility="{Binding Details, Converter={StaticResource NullToVis}}" />
                                    <TextBlock Margin="0,6,0,0" FontSize="11" FontWeight="SemiBold" ToolTip="{Binding Preset.PerformanceTip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Preset.PerformanceLevel}" Value="Medium">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Preset.PerformanceLevel}" Value="Heavy">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="⚡" /> <Run Text="{Binding Preset.PerformanceText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
    </DockPanel>
    </Border>
</Window>
