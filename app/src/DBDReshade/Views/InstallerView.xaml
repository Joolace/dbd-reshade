<UserControl x:Class="DBDReshade.Views.InstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DBDReshade.ViewModels"
             xmlns:m="clr-namespace:DBDReshade.Models"
             xmlns:h="clr-namespace:DBDReshade.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InstallerViewModel}"
             d:DesignWidth="900" d:DesignHeight="600"
             Focusable="True">

    <UserControl.Resources>
        <h:NullToVisibilityConverter x:Key="NullToVis" />
        <h:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
        <h:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <h:InverseBool x:Key="Inverse" />

        <!-- "Filters" button: looks like a normal button, accent border while the panel is open -->
        <Style x:Key="FilterToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One column of the filter panel: a list of choices, long names wrap instead of being cut -->
        <Style x:Key="FilterList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="MaxHeight" Value="300" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Star: outline, or filled in the accent color when the preset is a favorite -->
        <Style x:Key="StarText" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="&#xE734;" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Text" Value="&#xE735;" />
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,2,8,2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PresetItem" DataType="{x:Type m:Preset}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource StarButton}" ToolTip="{DynamicResource Inst.FavoriteTip}"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <TextBlock Style="{StaticResource StarText}" FontSize="12" VerticalAlignment="Center" />
                </Button>
                <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceBrush}" CornerRadius="4"
                        Padding="6,1" VerticalAlignment="Center" Margin="4,0,0,0"
                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource Common.Custom}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                </Border>
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentBrush}" CornerRadius="4"
                        Padding="6,1" VerticalAlignment="Center" Margin="4,0,0,0"
                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource Common.New}" FontSize="10" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" />
                </Border>
                <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceBrush}" CornerRadius="4"
                        Padding="6,1" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="{DynamicResource Inst.PopularTip}"
                        Visibility="{Binding IsPopular, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding InstallsText}" FontSize="10" Foreground="{DynamicResource TextBrush}" />
                </Border>
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Fit or scroll: the page fills the window, but below MinHeight it scrolls instead of cutting off the buttons -->
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" Padding="0,0,4,0">
    <Grid MinHeight="560" Height="{Binding ViewportHeight, ElementName=PageScroller}">
        <Grid.ColumnDefinitions>
            <!-- The list gives up space first when the window gets narrow -->
            <ColumnDefinition Width="0.42*" MinWidth="210" MaxWidth="320" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Preset list ================= -->
        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,2,4,10">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11">
                        <Run Text="{Binding VisibleCount, Mode=OneWay}" /> <Run Text="{DynamicResource Common.Presets}" />
                    </TextBlock>
                    <TextBlock Text="{DynamicResource Inst.Presets}" Style="{StaticResource SectionTitle}" Margin="0" />
                </DockPanel>

                <!-- "5 new presets" after a sync -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10,8" CornerRadius="8"
                        Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        Visibility="{Binding NewPresetsBanner, Converter={StaticResource NullToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="4" Margin="4,-2,-4,-2"
                                ToolTip="{DynamicResource Common.Close}" Command="{Binding DismissBannerCommand}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                Content="{DynamicResource Inst.ShowNew}" Command="{Binding ShowNewPresetsCommand}" />
                        <TextBlock Text="{Binding NewPresetsBanner}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                </Border>

                <!-- Search + Filters button; the filters open in a panel, so nothing gets cut in the narrow list -->
                <Grid x:Name="SearchRow" DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,8,7" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0"
                               HorizontalAlignment="Left" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" />
                    <TextBlock Text="{DynamicResource Inst.Search}" Margin="31,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Not clickable while the panel is open: a click outside closes it, and this would reopen it -->
                    <ToggleButton Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource FilterToggle}"
                                  ToolTip="{DynamicResource Inst.FiltersTip}"
                                  IsChecked="{Binding IsFilterPanelOpen}"
                                  IsHitTestVisible="{Binding IsFilterPanelOpen, Converter={StaticResource Inverse}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Inst.Filters}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" MinWidth="16" Height="16"
                                    Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveFilterCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActiveFilterCount}" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsFilterPanelOpen}" StaysOpen="False" AllowsTransparency="True"
                           PlacementTarget="{Binding ElementName=SearchRow}" Placement="Bottom" VerticalOffset="6"
                           PopupAnimation="Fade">
                        <Border Margin="0,0,12,12" Padding="16" CornerRadius="10" BorderThickness="1" Width="600"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
                            </Border.Effect>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6"
                                            ToolTip="{DynamicResource Common.Close}" Command="{Binding CloseFilterPanelCommand}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                            Margin="0,0,12,0" Content="{DynamicResource Inst.Filter.Clear}" Command="{Binding ClearFiltersCommand}"
                                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{DynamicResource Inst.Filters}" Style="{StaticResource SectionTitle}" Margin="0"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="11" Margin="10,0,0,6"
                                                   Text="{DynamicResource Inst.Filter.Show}" />
                                        <ListBox Style="{StaticResource FilterList}" ItemsSource="{Binding ShowOptions}"
                                                 SelectedItem="{Binding SelectedShow}" />
                                    </DockPanel>
                                    <DockPanel Grid.Column="2">
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="11" Margin="10,0,0,6"
                                                   Text="{DynamicResource Inst.Filter.Author}" />
                                        <ListBox Style="{StaticResource FilterList}" ItemsSource="{Binding AuthorOptions}"
                                                 SelectedItem="{Binding SelectedAuthor}" />
                                    </DockPanel>
                                    <DockPanel Grid.Column="4">
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="11" Margin="10,0,0,6"
                                                   Text="{DynamicResource Inst.Filter.Map}" />
                                        <ListBox Style="{StaticResource FilterList}" ItemsSource="{Binding MapOptions}"
                                                 SelectedItem="{Binding SelectedMap}" />
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Active filters at a glance, with a quick way to clear them -->
                <DockPanel DockPanel.Dock="Top" Margin="4,-4,4,10"
                           Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="11" Margin="8,0,0,0"
                            Content="{DynamicResource Inst.Filter.Clear}" Command="{Binding ClearFiltersCommand}" />
                    <TextBlock Text="{Binding ActiveFiltersText}" Style="{StaticResource Muted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveFiltersText}" />
                </DockPanel>

                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding SyncPresetsCommand}" ToolTip="{DynamicResource Inst.UpdatePresetsTip}">
                        <!-- DockPanel (not StackPanel) so a long translation is shortened with "…" instead of cut -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Inst.UpdatePresets}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Grid.Column="1" Margin="8,0,0,0" ToolTip="{DynamicResource Inst.OpenFolderTip}"
                            Command="{Binding OpenPresetsFolderCommand}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                    </Button>
                </Grid>

                <ListBox ItemsSource="{Binding PresetsView}" SelectedItem="{Binding SelectedPreset}"
                         ItemTemplate="{StaticResource PresetItem}" VirtualizingPanel.ScrollUnit="Pixel" />
            </DockPanel>
        </Border>

        <!-- ================= Details ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="110" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource StarButton}" VerticalAlignment="Center"
                            ToolTip="{DynamicResource Inst.FavoriteTip}" DataContext="{Binding SelectedPreset}"
                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <TextBlock Style="{StaticResource StarText}" FontSize="20" />
                    </Button>
                <Grid>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding SelectedPreset.DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Inst.SelectPreset}"
                               Visibility="{Binding SelectedPreset, Converter={StaticResource NullToCollapsed}}" />
                </Grid>
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Visibility="{Binding CurrentPresetName, Converter={StaticResource NullToVis}}">
                    <Run Text="{DynamicResource Inst.CurrentlyActive}" /> <Run Text="{Binding CurrentPresetName, Mode=OneWay}"
                                                                               Foreground="{DynamicResource TextBrush}" />
                </TextBlock>
            </StackPanel>

            <!-- Preview -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True" Cursor="Hand"
                    ToolTip="{DynamicResource Inst.PreviewTip}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowFullscreenCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="22" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{DynamicResource Inst.DownloadingPreview}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding PreviewMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,4"
                            CornerRadius="5" Background="{DynamicResource OverlayBrush}"
                            TextElement.Foreground="{DynamicResource OverlayTextBrush}"
                            Visibility="{Binding PreviewImage, Converter={StaticResource NullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE740;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Inst.FullScreen}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Description + source -->
            <StackPanel Grid.Row="2" Margin="0,12,0,12">
                <TextBlock Text="{Binding SelectedPreset.Description}" TextWrapping="Wrap" LineHeight="20"
                           MaxHeight="60" TextTrimming="WordEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                            Visibility="{Binding SelectedPreset.SourceLink, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{DynamicResource Inst.Source}" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <Button Style="{StaticResource LinkButton}" Content="{Binding SelectedPreset.SourceLink}"
                            ToolTip="{Binding SelectedPreset.SourceLink}" MaxWidth="520"
                            Command="{Binding OpenSourceCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Game + destination -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Game -->
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,-6,0,0">
                                <Button Style="{StaticResource GhostButton}" ToolTip="{DynamicResource Inst.DetectAgain}"
                                        Command="{Binding DetectInstallationsCommand}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" ToolTip="{DynamicResource Inst.PickGameTip}"
                                        Command="{Binding BrowseGameFolderCommand}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" FontSize="13" />
                                </Button>
                                <!-- Undo the last change (restore the backup taken before it) -->
                                <Button Style="{StaticResource GhostButton}" ToolTip="{Binding UndoTooltip}"
                                        ToolTipService.ShowOnDisabled="True" Command="{Binding UndoCommand}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" ToolTip="{DynamicResource Inst.UninstallTip}"
                                        Command="{Binding UninstallCommand}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Inst.Game}" Style="{StaticResource SectionTitle}" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReShadeInstalled}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ReShadeStatus}" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>

                        <Grid>
                            <ListBox ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}"
                                     MaxHeight="84">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:GameInstallation}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Store}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RootPath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}" ToolTip="{Binding RootPath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource Muted}" Margin="2,4" FontSize="12"
                                       Text="{DynamicResource Inst.GameNotFound}"
                                       Visibility="{Binding SelectedInstallation, Converter={StaticResource NullToCollapsed}}" />
                        </Grid>
                    </DockPanel>

                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />

                    <!-- Destination -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Inst.PresetFolder}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding DestinationFolder, TargetNullValue='—'}" TextWrapping="Wrap" FontSize="12"
                                   ToolTip="{Binding DestinationFolder}" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,10"
                                   Text="{DynamicResource Inst.GameFolderRecommended}"
                                   Visibility="{Binding IsUsingGameFolder, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,10"
                                   Text="{DynamicResource Inst.CustomFolder}"
                                   Visibility="{Binding IsUsingGameFolder, Converter={StaticResource InvBoolToVis}}" />
                        <WrapPanel>
                            <Button Content="{DynamicResource Inst.Change}" Command="{Binding BrowseDestinationCommand}" Padding="12,6"
                                    Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Inst.UseGameFolder}" Command="{Binding UseGameFolderCommand}" Padding="12,6"
                                    Style="{StaticResource GhostButton}"
                                    Visibility="{Binding IsUsingGameFolder, Converter={StaticResource InvBoolToVis}}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Install -->
            <!-- Progress on its own line; the buttons always stay on one line. FirstFitPanel shows the first
                 version that fits: with labels, or (narrow window) "Try on maps" / "Launch game" as icons only.
                 It's decided while measuring, so nothing jumps or overflows during a resize. -->
            <StackPanel Grid.Row="4">
                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,0,0,8"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" />
                </StackPanel>
                <h:FirstFitPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding TryOnMapsCommand}" Margin="0,0,10,0" Padding="16,11"
                                ToolTip="{DynamicResource Inst.TryOnMapsTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Inst.TryOnMaps}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LaunchGameCommand}" Margin="0,0,10,0" Padding="16,11"
                                ToolTip="{DynamicResource Inst.LaunchGameTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Inst.LaunchGame}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" MinWidth="200">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Inst.Install}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- Narrow: icons only (the tooltips still explain them) -->
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding TryOnMapsCommand}" Margin="0,0,10,0" Padding="14,11"
                                ToolTip="{DynamicResource Inst.TryOnMaps}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="14" />
                        </Button>
                        <Button Command="{Binding LaunchGameCommand}" Margin="0,0,10,0" Padding="14,11"
                                ToolTip="{DynamicResource Inst.LaunchGame}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Inst.Install}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </h:FirstFitPanel>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
