<UserControl x:Class="DBDReshade.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DBDReshade.ViewModels"
             xmlns:h="clr-namespace:DBDReshade.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900" d:DesignHeight="600">

    <UserControl.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
        <h:NullToVisibilityConverter x:Key="NullToVis" />
        <!-- Horizontal "segmented" choice built on ListBox, so selection logic stays in the view model -->
        <Style x:Key="ChoiceList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" MinWidth="120" Padding="16,10" CornerRadius="8" BorderThickness="1.5"
                                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                        <ContentPresenter HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Set.Title}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20" Text="{DynamicResource Set.Subtitle}" />

            <!-- Theme -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.Theme}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <ListBox Style="{StaticResource ChoiceList}" SelectedIndex="{Binding ThemeIndex}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Set.Theme.System}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Set.Theme.Light}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Set.Theme.Dark}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Language -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.Language}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Languages}"
                             SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName" />

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,8,0,14" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding HelpTranslateCommand}" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C1;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Set.Translate}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Set.TranslateText}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.Storage}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Set.StorageText}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.Resources>
                            <Style x:Key="SizeText" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,16,0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource Set.Previews}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SizeText}" Text="{Binding PreviewsSize}" />
                        <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource Set.Clear}" Margin="0,0,0,8"
                                Command="{Binding ClearPreviewsCommand}" MinWidth="110" />
                        <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,8"
                                ToolTip="{DynamicResource Set.OpenFolderTip}" Command="{Binding OpenStorageFolderCommand}" CommandParameter="previews">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                        </Button>

                        <TextBlock Grid.Row="1" Text="{DynamicResource Set.Maps}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SizeText}" Text="{Binding MapsSize}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource Set.Clear}" Margin="0,0,0,8"
                                Command="{Binding ClearMapsCommand}" MinWidth="110" />
                        <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,8"
                                ToolTip="{DynamicResource Set.OpenFolderTip}" Command="{Binding OpenStorageFolderCommand}" CommandParameter="maps">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                        </Button>

                        <TextBlock Grid.Row="2" Text="{DynamicResource Set.Logs}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SizeText}" Text="{Binding LogsSize}" />
                        <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource Set.Clear}" Margin="0,0,0,8"
                                Command="{Binding ClearLogsCommand}" MinWidth="110" />
                        <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,8"
                                ToolTip="{DynamicResource Set.OpenFolderTip}" Command="{Binding OpenStorageFolderCommand}" CommandParameter="logs">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                        </Button>

                        <TextBlock Grid.Row="3" Text="{DynamicResource Set.Temp}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SizeText}" Text="{Binding TempSize}" />
                        <Button Grid.Row="3" Grid.Column="2" Content="{DynamicResource Set.Clear}" Margin="0,0,0,8"
                                Command="{Binding ClearTempCommand}" MinWidth="110" />
                        <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,8"
                                ToolTip="{DynamicResource Set.OpenFolderTip}" Command="{Binding OpenStorageFolderCommand}" CommandParameter="temp">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                        </Button>

                        <TextBlock Grid.Row="4" Text="{DynamicResource Set.OfflineFiles}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SizeText}" Text="{Binding OfflineSize}" />
                        <Button Grid.Row="4" Grid.Column="2" Content="{DynamicResource Set.Clear}"
                                Command="{Binding ClearOfflineCommand}" MinWidth="110" />
                        <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                ToolTip="{DynamicResource Set.OpenFolderTip}" Command="{Binding OpenStorageFolderCommand}" CommandParameter="offline">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,14" />

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="{DynamicResource Set.OpenCacheTip}"
                                Command="{Binding OpenStorageFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Set.OpenData}" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" MinWidth="110"
                                Command="{Binding ClearAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Set.ClearAll}" />
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="{DynamicResource Set.Total}" /> <Run Text="{Binding TotalSize, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="{Binding FreedText}" Foreground="{DynamicResource SuccessBrush}" FontSize="12"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DataFolder}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- In-game shortcuts: keys that switch preset during a match (ReShade's preset shortcuts) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding Hotkeys}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Hotkeys.Title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Hotkeys.Text}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HotkeyRow}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding DataContext.Presets, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedItem="{Binding Preset}" DisplayMemberPath="DisplayName"
                                              ToolTip="{DynamicResource Hotkeys.PresetTip}" />
                                    <h:HotkeyBox Grid.Column="2" Style="{StaticResource {x:Type TextBox}}" TextAlignment="Center"
                                                 KeyCode="{Binding KeyCode}" Ctrl="{Binding Ctrl}" Shift="{Binding Shift}" Alt="{Binding Alt}"
                                                 ToolTip="{DynamicResource Hotkeys.KeyTip}" />
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Padding="8,6"
                                            ToolTip="{DynamicResource Hotkeys.Remove}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,4,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Hotkeys.Add}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,8" Command="{Binding UseFavoritesCommand}" ToolTip="{DynamicResource Hotkeys.FavoritesTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Hotkeys.Favorites}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,8" Style="{StaticResource GhostButton}" Command="{Binding ApplyCommand}"
                                ToolTip="{DynamicResource Hotkeys.ApplyTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Hotkeys.Apply}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Status, Converter={StaticResource NullToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DuplicateWarning}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource WarningBrush}"
                               Visibility="{Binding DuplicateWarning, Converter={StaticResource NullToVis}}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{DynamicResource Hotkeys.Note}" />
                </StackPanel>
            </Border>

            <!-- Streamer overlay: an OBS browser source saying the stream uses DBD Reshade (and which preset) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding Overlay}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Overlay.Title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Overlay.Text}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding Enabled}">
                        <TextBlock Text="{DynamicResource Overlay.Enable}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </CheckBox>

                    <StackPanel Margin="28,12,0,0" Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                        <!-- Address for OBS -->
                        <TextBlock Text="{DynamicResource Overlay.Address}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                    ToolTip="{DynamicResource Overlay.PreviewTip}" Command="{Binding OpenPreviewCommand}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" />
                            </Button>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding CopyUrlCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Overlay.Copy}" />
                                </StackPanel>
                            </Button>
                            <TextBox Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" />
                        </DockPanel>
                        <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding Status, Converter={StaticResource NullToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding NowShowing}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Preview in the app: the badge as viewers see it (drawn here, same options as the page) -->
                        <CheckBox IsChecked="{Binding ShowInAppPreview}" Margin="0,12,0,6">
                            <TextBlock Text="{DynamicResource Overlay.PreviewTitle}" />
                        </CheckBox>
                        <Border CornerRadius="8" Height="96" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding ShowInAppPreview, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3A4A3A" Offset="0" />
                                    <GradientStop Color="#2B2F3A" Offset="0.55" />
                                    <GradientStop Color="#4A3A35" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Margin="12" VerticalAlignment="Center" CornerRadius="12" BorderBrush="{DynamicResource AccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#C70E0E12" />
                                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            <Setter Property="Padding" Value="8,8,16,8" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="TextElement.Foreground" Value="#F2F2F5" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLight}" Value="True">
                                                    <Setter Property="Background" Value="#DBFFFFFF" />
                                                    <Setter Property="TextElement.Foreground" Value="#15151A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMinimal}" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AlignRight}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PreviewHidden}" Value="True">
                                                    <Setter Property="Opacity" Value="0.25" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/logo.png" Width="36" Height="36" Margin="0,0,10,0"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="DBD RESHADE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding PreviewTitle}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                            <TextBlock Text="{Binding PreviewAuthor}" FontSize="11" Opacity="0.65"
                                                       Visibility="{Binding PreviewAuthor, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,2" CornerRadius="4"
                                        Background="#99000000" Visibility="{Binding PreviewHidden, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource Overlay.PreviewHidden}" FontSize="10" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- What it shows -->
                        <WrapPanel Margin="0,12,0,0">
                            <WrapPanel.Resources>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                    <Setter Property="Margin" Value="0,0,20,8" />
                                </Style>
                            </WrapPanel.Resources>
                            <CheckBox IsChecked="{Binding ShowPreset}" Content="{DynamicResource Overlay.ShowPreset}" />
                            <CheckBox IsChecked="{Binding ShowAuthor}" Content="{DynamicResource Overlay.ShowAuthor}"
                                      IsEnabled="{Binding ShowPreset}" />
                            <CheckBox IsChecked="{Binding OnlyWhilePlaying}" Content="{DynamicResource Overlay.OnlyWhilePlaying}" />
                            <CheckBox IsChecked="{Binding IsMinimal}" Content="{DynamicResource Overlay.Minimal}" />
                            <CheckBox IsChecked="{Binding IsLight}" Content="{DynamicResource Overlay.Light}" />
                            <CheckBox IsChecked="{Binding AlignRight}" Content="{DynamicResource Overlay.AlignRight}" />
                        </WrapPanel>

                        <!-- Port + text file -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource Overlay.Port}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding PortText, UpdateSourceTrigger=LostFocus}" Width="80" MaxLength="5"
                                     ToolTip="{DynamicResource Overlay.PortTip}" />
                        </StackPanel>
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    ToolTip="{DynamicResource Set.OpenFolderTip}" Command="{Binding ShowTextFileCommand}"
                                    Visibility="{Binding WriteTextFile, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                            </Button>
                            <CheckBox IsChecked="{Binding WriteTextFile}">
                                <TextBlock Text="{DynamicResource Overlay.TextFile}" TextWrapping="Wrap" />
                            </CheckBox>
                        </DockPanel>

                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource Overlay.Obs}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Offline use: download everything once, then the app works without internet -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Offline.Title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Offline.Text}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="13"
                                    Command="{Binding DownloadOfflineCommand}"
                                    Visibility="{Binding IsDownloadingOffline, Converter={x:Static h:InverseBoolToVisibility.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Offline.Download}" />
                                </StackPanel>
                            </Button>
                            <Button Content="{DynamicResource Offline.Cancel}" Command="{Binding CancelOfflineCommand}"
                                    Visibility="{Binding IsDownloadingOffline, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding OfflineLastText}" />
                            <TextBlock Text="{DynamicResource Offline.NeedsInternet}" Style="{StaticResource Muted}" FontSize="12"
                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding IsOnline, Converter={x:Static h:InverseBoolToVisibility.Instance}}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding OfflineStatus, Converter={StaticResource NullToVis}}">
                        <ProgressBar Value="{Binding OfflineProgress}" Maximum="100" Margin="0,0,0,6"
                                     Visibility="{Binding IsDownloadingOffline, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding OfflineStatus}" Style="{StaticResource Muted}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Privacy: community ranking (hidden while the ranking service isn't set up) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding RankingAvailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.Privacy}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Set.ShareUsageText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <CheckBox IsChecked="{Binding ShareUsage}">
                        <TextBlock Text="{DynamicResource Set.ShareUsage}" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Border.Resources>
                    <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="Margin" Value="0,0,16,6" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                    </Style>
                    <Style x:Key="InfoValue" TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="InfoLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Command" Value="{Binding OpenLinkCommand}" />
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set.AboutTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                    <!-- Logo, name, version -->
                    <DockPanel Margin="0,0,0,16">
                        <Image DockPanel.Dock="Left" Source="/Assets/logo.png" Width="56" Height="56" Margin="0,0,14,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DBD Reshade" FontSize="18" FontWeight="Bold" />
                            <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Set.Tagline}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource InfoLabel}" Text="{DynamicResource Set.Developer}" />
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoLink}"
                                Content="{Binding DeveloperName}" CommandParameter="{Binding DeveloperUrl}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource InfoLabel}" Text="{DynamicResource Set.Version}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding BuildText}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource InfoLabel}" Text="{DynamicResource Set.License}" />
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoLink}"
                                Content="{Binding LicenseName}" CommandParameter="{Binding LicenseUrl}" />

                        <TextBlock Grid.Row="3" Style="{StaticResource InfoLabel}" Text="{DynamicResource Set.PoweredBy}" />
                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoLink}"
                                Content="{DynamicResource Set.ReShadeCredit}" CommandParameter="{Binding ReShadeUrl}" />

                        <TextBlock Grid.Row="4" Style="{StaticResource InfoLabel}" Text="{DynamicResource Set.Thanks}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{DynamicResource Set.ThanksText}" />

                        <TextBlock Grid.Row="5" Style="{StaticResource InfoLabel}" Text="{DynamicResource Set.Changelog}" />
                        <Button Grid.Row="5" Grid.Column="1" Style="{StaticResource InfoLink}"
                                Content="{DynamicResource Set.ReleaseNotes}" Command="{Binding ShowWhatsNewCommand}" />
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10,0,14" />

                    <!-- Links -->
                    <WrapPanel>
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="Command" Value="{Binding OpenLinkCommand}" />
                            </Style>
                        </WrapPanel.Resources>
                        <Button CommandParameter="{Binding RepoUrl}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16" Height="16" Margin="0,0,8,0">
                                    <Border.Background><ImageBrush ImageSource="/Assets/Icons/github.png" Stretch="Uniform" /></Border.Background>
                                </Border>
                                <TextBlock Text="GitHub" />
                            </StackPanel>
                        </Button>
                        <Button CommandParameter="{Binding WebsiteUrl}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Set.Website}" />
                            </StackPanel>
                        </Button>
                        <Button CommandParameter="{Binding DiscordUrl}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16" Height="16" Margin="0,0,8,0">
                                    <Border.Background><ImageBrush ImageSource="/Assets/Icons/discord.png" Stretch="Uniform" /></Border.Background>
                                </Border>
                                <TextBlock Text="Discord" />
                            </StackPanel>
                        </Button>
                        <Button CommandParameter="{Binding TwitchUrl}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Twitch" />
                            </StackPanel>
                        </Button>
                        <Button CommandParameter="{Binding InstagramUrl}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16" Height="16" Margin="0,0,8,0">
                                    <Border.Background><ImageBrush ImageSource="/Assets/Icons/instagram.png" Stretch="Uniform" /></Border.Background>
                                </Border>
                                <TextBlock Text="Instagram" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ReportBugCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEBE8;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Footer.ReportBug}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
