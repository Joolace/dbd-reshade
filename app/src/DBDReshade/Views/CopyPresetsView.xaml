<UserControl x:Class="DBDReshade.Views.CopyPresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DBDReshade.ViewModels"
             xmlns:m="clr-namespace:DBDReshade.Models"
             xmlns:h="clr-namespace:DBDReshade.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CopyPresetsViewModel}"
             d:DesignWidth="900" d:DesignHeight="600">

    <UserControl.Resources>
        <h:NullToVisibilityConverter x:Key="NullToVis" />
        <h:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Copy.Title}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{DynamicResource Copy.Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                            Content="{Binding ToggleAllText}" Command="{Binding ToggleAllCommand}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Margin="0">
                        <Run Text="{DynamicResource Copy.Selected}" /> <Run Text="{Binding SelectedCount, Mode=OneWay}" /> / <Run Text="{Binding Items.Count, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>

                <ListBox ItemsSource="{Binding Items}" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Several columns so 100+ presets fit without endless scrolling -->
                            <UniformGrid Columns="3" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,7" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:SelectablePreset}">
                            <CheckBox IsChecked="{Binding IsSelected}" ToolTip="{Binding Preset.FileName}">
                                <TextBlock Text="{Binding Preset.DisplayName}" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource Copy.Destination}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DestinationFolder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DestinationFolder}"
                               Visibility="{Binding DestinationFolder, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{DynamicResource Copy.NoFolder}" Style="{StaticResource Muted}"
                               Visibility="{Binding DestinationFolder, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Copy.ChooseFolder}" Command="{Binding BrowseDestinationCommand}"
                        Margin="0,0,10,0" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding CopyCommand}" MinWidth="200">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="14" Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource Copy.CopySelected}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
