<Window x:Class="DBDReshade.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DBDReshade.ViewModels"
        xmlns:h="clr-namespace:DBDReshade.Helpers"
        xmlns:local="clr-namespace:DBDReshade.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:WhatsNewViewModel}"
        Title="{DynamicResource WhatsNew.Title}"
        Style="{StaticResource ChromeWindow}"
        Width="680" Height="720" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <DockPanel>
    <local:TitleBar DockPanel.Dock="Top" />
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0"
                    Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE789;" FontSize="20" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource WhatsNew.Title}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{Binding Subtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Releases -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding Releases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReleaseItem}">
                            <Border CornerRadius="10" BorderThickness="1" Padding="18,16" Margin="0,0,0,12"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12"
                                                   VerticalAlignment="Center" Text="{Binding Date}" />
                                        <WrapPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource LinkButton}" FontSize="16" FontWeight="Bold"
                                                    Foreground="{DynamicResource TextBrush}" Content="{Binding Title}"
                                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}" ToolTip="{Binding Url}" Margin="0,0,10,0" />
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="7,2"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{DynamicResource WhatsNew.Current}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource OnAccentBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="7,1" VerticalAlignment="Center"
                                                    Visibility="{Binding IsNewer, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{DynamicResource WhatsNew.Newer}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </WrapPanel>
                                    </DockPanel>
                                    <StackPanel h:Markdown.Text="{Binding Body}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{DynamicResource WhatsNew.Loading}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{DynamicResource WhatsNew.Error}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="40"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Buttons -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="120"
                    Content="{DynamicResource Common.Close}" Command="{Binding CloseCommand}" IsDefault="True" IsCancel="True" />
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding OpenReleasesCommand}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Margin="0,0,8,0">
                        <Border.Background><ImageBrush ImageSource="/Assets/Icons/github.png" Stretch="Uniform" /></Border.Background>
                    </Border>
                    <TextBlock Text="{DynamicResource WhatsNew.AllReleases}" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
    </DockPanel>
    </Border>
</Window>
