<Window x:Class="DBDReshade.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DBDReshade.ViewModels"
        xmlns:views="clr-namespace:DBDReshade.Views"
        xmlns:h="clr-namespace:DBDReshade.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="DBD Reshade"
        Style="{StaticResource ChromeWindow}"
        Icon="/Assets/app.ico"
        Width="1180" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- Each page view model is rendered by its own view -->
        <DataTemplate DataType="{x:Type vm:InstallerViewModel}">
            <views:InstallerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PresetManagerViewModel}">
            <views:PresetManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CopyPresetsViewModel}">
            <views:CopyPresetsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <views:EditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="SocialButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <!-- The social icons are white PNGs: used as a mask so they take the theme's text color -->
        <!-- A Rectangle has no size of its own and the button centers its content: without Width/Height
             it would be 0×0 and the icon invisible. -->
        <Style x:Key="SocialIcon" TargetType="Rectangle">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </Window.Resources>

    <!-- Root: thin border + own title bar (see Views/TitleBar.xaml) above the app -->
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <DockPanel>
    <views:TitleBar DockPanel.Dock="Top" />
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16" LastChildFill="True">

                <Image DockPanel.Dock="Top" Source="/Assets/logo.png" Height="64" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,28" />

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Update.Title}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10" FontSize="12">
                                <Run Text="{DynamicResource Update.Text}" /> <Run Text="{Binding AvailableUpdate.Tag, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <Button Style="{StaticResource PrimaryButton}" Padding="10,7" FontSize="12"
                                    Content="{DynamicResource Update.Install}" Command="{Binding UpdateNowCommand}"
                                    Visibility="{Binding IsUpdating, Converter={x:Static h:InverseBoolToVisibility.Instance}}" />
                            <StackPanel Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Update.Downloading}" FontSize="12" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" />
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}" Content="{DynamicResource Update.Notes}" FontSize="11"
                                    Margin="0,8,0,0" HorizontalAlignment="Center" Command="{Binding OpenUpdateCommand}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0,0,0,8" ToolTip="{DynamicResource Footer.ReportBugTip}" Command="{Binding ReportBugCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEBE8;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Footer.ReportBug}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button Style="{StaticResource SocialButton}" ToolTip="Discord"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://discord.gg/mC7Eabu3QW">
                            <Rectangle Style="{StaticResource SocialIcon}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/Icons/discord.png" Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Button>
                        <Button Style="{StaticResource SocialButton}" ToolTip="GitHub"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/Joolace/dbd-reshade">
                            <Rectangle Style="{StaticResource SocialIcon}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/Icons/github.png" Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Button>
                        <Button Style="{StaticResource SocialButton}" ToolTip="Instagram"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://www.instagram.com/joolace">
                            <Rectangle Style="{StaticResource SocialIcon}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/Icons/instagram.png" Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Button>
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="{Binding VersionText, Mode=OneWay}" /> · <Run Text="{DynamicResource Footer.DevelopedBy}" /> <Run Text="{Binding Author, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Navigation -->
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="4,4">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Content="{Binding SelectedPage.Page}" Focusable="False" Margin="28,24,28,16" />

            <!-- Log panel -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,6,12,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" ToolTip="{DynamicResource Log.OpenData}"
                                    Command="{Binding OpenDataFolderCommand}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" ToolTip="{DynamicResource Log.Clear}"
                                    Command="{Binding ClearLogCommand}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                            </Button>
                            <ToggleButton IsChecked="{Binding IsLogExpanded}" Cursor="Hand"
                                          ToolTip="{DynamicResource Log.Toggle}" Background="Transparent" BorderThickness="0"
                                          Foreground="{DynamicResource TextMutedBrush}" Padding="8,6">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12"
                                                       Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Log.Title}" Style="{StaticResource SectionTitle}" Margin="0"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Height="150" Margin="12,0,12,10"
                             Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="8,1" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource LogTimeBrush}" Margin="0,0,10,0" />
                                    <!-- Triggers + DynamicResource so existing lines recolor when the theme changes -->
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource LogInfoBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                        <Setter Property="Foreground" Value="{DynamicResource LogSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource LogWarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
    </DockPanel>
    </Border>
</Window>
