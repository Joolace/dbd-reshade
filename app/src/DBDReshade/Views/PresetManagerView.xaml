<UserControl x:Class="DBDReshade.Views.PresetManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DBDReshade.ViewModels"
             xmlns:m="clr-namespace:DBDReshade.Models"
             xmlns:h="clr-namespace:DBDReshade.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PresetManagerViewModel}"
             d:DesignWidth="900" d:DesignHeight="600">

    <UserControl.Resources>
        <h:NullToVisibilityConverter x:Key="NullToVis" />
        <h:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Man.Title}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{DynamicResource Man.Subtitle}" />
        </StackPanel>

        <!-- ================= New preset form ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Man.Add}" Style="{StaticResource SectionTitle}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Man.File}" Margin="0,4,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding IniPath, Mode=OneWay}" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="{DynamicResource Man.Browse}" Margin="8,0,0,0"
                                Command="{Binding BrowseIniCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Man.Description}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="70" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Man.Source}" />
                    <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" Text="{DynamicResource Man.SourceHint}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Man.Screenshot}" />
                    <Border Height="150" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding ScreenshotPreview}" Stretch="UniformToFill" />
                            <TextBlock Text="{DynamicResource Man.NoScreenshot}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding ScreenshotPreview, Converter={StaticResource NullToCollapsed}}" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{DynamicResource Man.ChooseImage}" Command="{Binding BrowseScreenshotCommand}" />
                        <Button Content="{DynamicResource Man.Remove}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding ClearScreenshotCommand}"
                                Visibility="{Binding ScreenshotPath, Converter={StaticResource NullToVis}}" />
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" HorizontalAlignment="Left"
                            MinWidth="200" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{DynamicResource Man.Save}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= Library ================= -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,2,4,10">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11">
                        <Run Text="{Binding Presets.Count, Mode=OneWay}" /> <Run Text="{DynamicResource Common.Presets}" />
                    </TextBlock>
                    <TextBlock Text="{DynamicResource Man.Library}" Style="{StaticResource SectionTitle}" Margin="0" />
                </DockPanel>

                <!-- Import a shared preset package (also works by dropping files on the window) -->
                <Button DockPanel.Dock="Top" Margin="0,0,0,4" Command="{Binding ImportCommand}"
                        ToolTip="{DynamicResource Man.ImportTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Man.Import}" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="11" Margin="2,0,2,10"
                           TextWrapping="Wrap" Text="{DynamicResource Man.DropHint}" />

                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Margin="0,6,0,0"
                        HorizontalAlignment="Center" Command="{Binding RestoreDeletedCommand}"
                        Visibility="{Binding HasDeletedPresets, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock>
                            <Run Text="{DynamicResource Man.Restore}" /> (<Run Text="{Binding DeletedCount, Mode=OneWay}" />)
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource DangerButton}" Margin="0,8,0,0"
                        Command="{Binding DeleteCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Man.Delete}" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Bottom" Margin="0,10,0,0" Command="{Binding ExportCommand}"
                        ToolTip="{DynamicResource Man.ExportTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Man.Export}" />
                    </StackPanel>
                </Button>

                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Preset}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceBrush}" CornerRadius="4"
                                        Padding="6,1" VerticalAlignment="Center"
                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource Common.Custom}" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
