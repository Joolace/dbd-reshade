<UserControl x:Class="DBDReshade.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DBDReshade.ViewModels"
             xmlns:s="clr-namespace:DBDReshade.Services"
             xmlns:h="clr-namespace:DBDReshade.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:EditorViewModel}"
             d:DesignWidth="900" d:DesignHeight="640">

    <UserControl.Resources>
        <h:NullToVisibilityConverter x:Key="NullToVis" />
        <h:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
        <h:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <!-- Fit or scroll: the page fills the window, but below MinHeight it scrolls instead of cutting off the cards -->
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" Padding="0,0,4,0">
    <Grid MinHeight="620" Height="{Binding ViewportHeight, ElementName=PageScroller}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Edit.Title}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{DynamicResource Edit.Subtitle}" />
        </StackPanel>

        <!-- ================= Left: 1 name/base, 2 screenshots ================= -->
        <Grid Grid.Row="1">
            <!-- Minimum heights keep each card's fields and buttons visible; below that the page scrolls -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="270" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" MinHeight="200" />
            </Grid.RowDefinitions>

            <!-- 1 -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{DynamicResource Edit.Step1}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Edit.Name}" Margin="0,2,0,6" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource DangerForegroundBrush}" FontSize="11"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding NameError, Converter={StaticResource NullToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="12" Margin="0,0,6,0"
                                       Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{DynamicResource Edit.DraftExists}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Edit.StartFrom}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedBase}" DisplayMemberPath="DisplayName"
                             IsEnabled="{Binding HasDraft, Converter={x:Static h:InverseBool.Instance}}"
                             VirtualizingPanel.ScrollUnit="Pixel" />
                </DockPanel>
            </Border>

            <!-- 2 -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Edit.Step2}" Style="{StaticResource SectionTitle}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Command="{Binding AddScreenshotsCommand}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Map.AddScreenshots}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" ToolTip="{DynamicResource Map.OpenMyScreenshots}"
                                Command="{Binding OpenMyScreenshotsCommand}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                        </Button>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type s:MapInfo}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceBrush}" CornerRadius="4"
                                            Padding="6,1" VerticalAlignment="Center"
                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Map.Downloaded}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                    <TextBlock FontSize="14" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE707;" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Text" Value="&#xEB9F;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Right: 3 edit, 4 save ================= -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 3 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Edit.Step3}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Edit.HowTo}" LineHeight="19" />

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                            <ProgressBar Value="{Binding ProgressValue}" Maximum="100" />
                        </StackPanel>

                        <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource BannerBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="14" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource Edit.Editing}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenEditorCommand}" MinWidth="200">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="{DynamicResource Edit.Open}"
                                               Visibility="{Binding HasDraft, Converter={StaticResource InvBoolToVis}}" />
                                    <TextBlock Text="{DynamicResource Edit.Continue}"
                                               Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding DiscardCommand}"
                                    Content="{DynamicResource Edit.Discard}"
                                    Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Edit.Step4}" Style="{StaticResource SectionTitle}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Man.Description}" Margin="0,2,0,6" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="60" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Man.Source}" />
                        <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Man.Screenshot}" />
                        <Border Height="140" CornerRadius="6" ClipToBounds="True"
                                Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Image Source="{Binding ScreenshotPreview}" Stretch="UniformToFill" />
                                <TextBlock Text="{DynamicResource Man.NoScreenshot}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="{Binding ScreenshotPreview, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" Text="{DynamicResource Edit.ScreenshotHint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{DynamicResource Man.ChooseImage}" Command="{Binding ChooseScreenshotCommand}" />
                            <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" ToolTip="{DynamicResource Edit.OpenShots}"
                                    Command="{Binding OpenScreenshotsFolderCommand}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                            </Button>
                            <Button Content="{DynamicResource Man.Remove}" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Command="{Binding ClearScreenshotCommand}"
                                    Visibility="{Binding ScreenshotPath, Converter={StaticResource NullToVis}}" />
                        </StackPanel>

                        <Button Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" HorizontalAlignment="Left" MinWidth="200"
                                Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Edit.Save}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </ScrollViewer>
</UserControl>
