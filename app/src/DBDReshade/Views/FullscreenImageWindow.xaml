<Window x:Class="DBDReshade.Views.FullscreenImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Background="Black"
        Foreground="White"
        FontFamily="{DynamicResource AppFont}"
        Cursor="Hand">
    <!-- Always black, whatever the theme: it's a photo viewer -->
    <Grid>
        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

        <TextBlock x:Name="LoadingText" Text="{DynamicResource Full.Loading}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="#9A9AA8" />

        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Padding="16,8"
                CornerRadius="8" Background="#B0000000">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" />
                <TextBlock Text="   ·   " Foreground="#9A9AA8" />
                <TextBlock Text="{DynamicResource Full.Close}" Foreground="#9A9AA8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
