<Window x:Class="DBDReshade.Views.FullscreenImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DBDReshade.ViewModels"
        xmlns:h="clr-namespace:DBDReshade.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:PresetViewerViewModel}"
        Title="Preview"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Background="Black"
        Foreground="White"
        FontFamily="{DynamicResource AppFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
        <h:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Round icon buttons of the floating bar (always light on dark: it's a photo viewer) -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The picture: a click here closes the viewer -->
        <Grid x:Name="Stage" Background="Black" Cursor="Hand">
            <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{DynamicResource Full.Loading}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9A9AA8"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Message}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9A9AA8"
                       Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
        </Grid>

        <!-- Top: preset name, author/map, performance -->
        <Border x:Name="TopInfo" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Padding="18,9"
                CornerRadius="10" Background="#B0000000">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Current.DisplayName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Details}" Foreground="#B5B5C0" Margin="12,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding Details, Converter={StaticResource NullToVis}}" />
                <Border Margin="12,0,0,0" Padding="7,2" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                        ToolTip="{Binding Current.PerformanceTip}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#4CC38A" />
                            <Setter Property="TextElement.Foreground" Value="#4CC38A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.PerformanceLevel}" Value="Medium">
                                    <Setter Property="BorderBrush" Value="#F5B841" />
                                    <Setter Property="TextElement.Foreground" Value="#F5B841" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Current.PerformanceLevel}" Value="Heavy">
                                    <Setter Property="BorderBrush" Value="#F0636B" />
                                    <Setter Property="TextElement.Foreground" Value="#F0636B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Current.PerformanceText}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Bottom: log (optional), install progress, floating bar -->
        <StackPanel x:Name="BottomArea" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28">

            <!-- Log -->
            <Border Width="760" Height="220" Margin="0,0,0,10" CornerRadius="12" Background="#E6101014" Padding="6"
                    BorderBrush="#33FFFFFF" BorderThickness="1"
                    Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
                <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="8,1" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding TimeText}" Foreground="#80808C" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D6D6DE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                                    <Setter Property="Foreground" Value="#4CC38A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#F5B841" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="#F0636B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Install progress -->
            <Border HorizontalAlignment="Center" Margin="0,0,0,10" Padding="14,8" CornerRadius="10" Background="#E6101014" MinWidth="360"
                    Visibility="{Binding Installer.IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Installer.StatusText}" FontSize="12" Foreground="#D6D6DE" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding Installer.ProgressValue}" Maximum="100" Height="4" />
                </StackPanel>
            </Border>

            <!-- The floating bar -->
            <Border x:Name="Bar" HorizontalAlignment="Center" Padding="8" CornerRadius="16" Background="#E6141418"
                    BorderBrush="#33FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BarButton}" ToolTip="{DynamicResource Full.Previous}" Command="{Binding PreviousCommand}"
                            IsEnabled="{Binding CanBrowse}">
                        <TextBlock Style="{StaticResource BarIcon}" Text="&#xE76B;" />
                    </Button>
                    <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Margin="6,0" MinWidth="64" TextAlignment="Center"
                               Foreground="#B5B5C0" FontSize="12" />
                    <Button Style="{StaticResource BarButton}" ToolTip="{DynamicResource Full.Next}" Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanBrowse}">
                        <TextBlock Style="{StaticResource BarIcon}" Text="&#xE76C;" />
                    </Button>

                    <Rectangle Width="1" Fill="#33FFFFFF" Margin="8,8" />

                    <Button Style="{StaticResource BarButton}" ToolTip="{DynamicResource Full.Favorite}" Command="{Binding ToggleFavoriteCommand}">
                        <TextBlock FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE734;" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Current.IsFavorite}" Value="True">
                                            <Setter Property="Text" Value="&#xE735;" />
                                            <Setter Property="Foreground" Value="#F5B841" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Install -->
                    <Button Margin="6,0" Padding="16,0" Height="42" Cursor="Hand" Focusable="False" Command="{Binding InstallCommand}"
                            ToolTip="{DynamicResource Full.InstallTip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="21" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarIcon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Inst.Install}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BarButton}" ToolTip="{DynamicResource Full.Log}" Command="{Binding ToggleLogCommand}">
                        <TextBlock Style="{StaticResource BarIcon}" Text="&#xE8A5;" />
                    </Button>

                    <Rectangle Width="1" Fill="#33FFFFFF" Margin="8,8" />

                    <Button Style="{StaticResource BarButton}" ToolTip="{DynamicResource Full.CloseTip}" Command="{Binding CloseCommand}">
                        <TextBlock Style="{StaticResource BarIcon}" Text="&#xE711;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Key legend: on its own dark pill, so it stays readable on bright previews -->
            <Border HorizontalAlignment="Center" Margin="0,8,0,0" Padding="12,5" CornerRadius="10" Background="#D9141418"
                    BorderBrush="#26FFFFFF" BorderThickness="1">
                <TextBlock Text="{DynamicResource Full.Keys}" FontSize="12" Foreground="#E6E6EC" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
